# =============================================================================
# Ethos PR Intelligence - Variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA commitees el archivo ".env" (ya está en .gitignore).
# En GitHub Actions, configura estos mismos valores como "Secrets".
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase / PostgreSQL  (base histórica real)
# ---------------------------------------------------------------------------
# URL del proyecto, p.ej. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service Role Key (NO la anon key). Solo se usa en backend / Actions.
# Tiene permisos totales: trátala como una contraseña maestra.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Sheets  (panel de control)
# ---------------------------------------------------------------------------
# Email de la cuenta de servicio (Service Account) de Google Cloud.
# La Google Sheet debe estar COMPARTIDA con este email como "Editor".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio.
# Pega el valor completo entre comillas dobles. Conserva los \n literales:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
# ID de la Google Sheet (la parte entre /d/ y /edit en la URL).
# Panel actual: 1aPGIO5zt5b2C1sdC2lOPsmjhcpudn_NvmlCJ8OW39es
GOOGLE_SHEET_ID=1aPGIO5zt5b2C1sdC2lOPsmjhcpudn_NvmlCJ8OW39es

# ---------------------------------------------------------------------------
# Ejecución
# ---------------------------------------------------------------------------
# Identificador de quién corre el proceso (aparece en logs): local | github-actions | cron
RUN_BY=local
# Nivel de log: trace | debug | info | warn | error
LOG_LEVEL=info
# pretty = salida legible en consola; json = salida estructurada (Actions)
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# IA  (Fase 7 - no se consume en el MVP)
# ---------------------------------------------------------------------------
# API key de Anthropic (Claude). Déjala vacía hasta activar la fase de IA.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Endpoint XML  (Fase 6+ - Cloudflare Worker)
# ---------------------------------------------------------------------------
# Token para proteger /read-xml. Genera uno largo y aleatorio.
XML_SECRET_TOKEN=

# ---------------------------------------------------------------------------
# Módulo de envío interno de alertas  (PILOTO CLI-0002 — DISABLED BY DEFAULT)
# ---------------------------------------------------------------------------
# IMPORTANTE: este módulo NO envía nada con la configuración por defecto.
# Para enviar alerta REAL deben cumplirse TODAS estas capas (AND):
#   1) SEND_ALERTS=true
#   2) ALLOW_REAL_ALERTS=true
#   3) REAL_ALERTS_CONFIRMATION_TOKEN presente y == token pasado por --token
#   4) cliente en ALERTS_ALLOWED_CLIENTS
#   5) severidad en ALERTS_ALLOWED_SEVERITIES
#   6) ALERTS_INTERNAL_ONLY=true (fase inicial: solo interno)
#   7) hay destinatarios internos del canal habilitado
#   8) el canal específico está enabled
#   9) la alerta trae sin_envio=false explícito (las filas shadow son sin_envio=true)
# Además el script exige el flag --send-real; en dry-run NUNCA envía.

# Kill-switch global (déjalo en false salvo piloto autorizado)
SEND_ALERTS=false
ALLOW_REAL_ALERTS=false

# Piloto interno
ALERTS_INTERNAL_ONLY=true
ALERTS_ALLOWED_CLIENTS=CLI-0002
ALERTS_ALLOWED_SEVERITIES=P1
ALERTS_MAX_PER_RUN=5
ALERTS_MAX_PER_DAY=5

# Email (SMTP interno). smtpHostDomain es lo único que se loggea; nunca el password.
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
INTERNAL_ALERT_EMAILS=

# WhatsApp / Twilio (opcional; not_configured hasta tener credenciales)
WHATSAPP_ALERTS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
INTERNAL_ALERT_WHATSAPP_NUMBERS=

# Token de seguridad: debe coincidir con --token=<valor> al intentar envío real.
REAL_ALERTS_CONFIRMATION_TOKEN=
