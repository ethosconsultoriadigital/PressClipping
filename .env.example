# =============================================================================
# Ethos PR Intelligence - Variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA commitees el archivo ".env" (ya está en .gitignore).
# En GitHub Actions, configura estos mismos valores como "Secrets".
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase / PostgreSQL  (base histórica real)
# ---------------------------------------------------------------------------
# URL del proyecto, p.ej. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service Role Key (NO la anon key). Solo se usa en backend / Actions.
# Tiene permisos totales: trátala como una contraseña maestra.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Sheets  (panel de control)
# ---------------------------------------------------------------------------
# Email de la cuenta de servicio (Service Account) de Google Cloud.
# La Google Sheet debe estar COMPARTIDA con este email como "Editor".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada de la cuenta de servicio.
# Pega el valor completo entre comillas dobles. Conserva los \n literales:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
# ID de la Google Sheet (la parte entre /d/ y /edit en la URL).
# Panel actual: 1aPGIO5zt5b2C1sdC2lOPsmjhcpudn_NvmlCJ8OW39es
GOOGLE_SHEET_ID=1aPGIO5zt5b2C1sdC2lOPsmjhcpudn_NvmlCJ8OW39es

# ---------------------------------------------------------------------------
# Ejecución
# ---------------------------------------------------------------------------
# Identificador de quién corre el proceso (aparece en logs): local | github-actions | cron
RUN_BY=local
# Nivel de log: trace | debug | info | warn | error
LOG_LEVEL=info
# pretty = salida legible en consola; json = salida estructurada (Actions)
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# IA  (Fase 7 - no se consume en el MVP)
# ---------------------------------------------------------------------------
# API key de Anthropic (Claude). Déjala vacía hasta activar la fase de IA.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Endpoint XML  (Fase 6+ - Cloudflare Worker)
# ---------------------------------------------------------------------------
# Token para proteger /read-xml. Genera uno largo y aleatorio.
XML_SECRET_TOKEN=
